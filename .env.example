# Configuration reference only. Copy values to the private .env file next to run_ui.py.
# run_ui.py loads .env at startup; this example file is not loaded.

# Optional: separate SQLite database for an isolated demonstration.
COGU_CATALOG_DB=

# Customer/admin cookies should use Secure on HTTPS deployments.
COGU_COOKIE_SECURE=0
# Optional legacy Demo Lab administrator order token (separate from staff accounts).
COGU_ADMIN_TOKEN=

# Phase 6 image-content search. Empty values keep labeled DEMO samples.
COGU_IMAGE_ENCODER_URL=
COGU_IMAGE_ENCODER_MODEL=
COGU_IMAGE_ENCODER_API_KEY=

# Phase 7 grounded shopping AI. Empty values keep labeled DEMO rules.
COGU_LLM_URL=
COGU_LLM_MODEL=
COGU_LLM_API_KEY=

# Phase 8 outfit generation. Leave empty for labeled sample previews.
# Set COGU_OUTFIT_PROVIDER=openai for direct OpenAI Images Edit API integration.
# With openai mode, COGU_OUTFIT_PROVIDER_URL can stay empty and the server uses
# https://api.openai.com/v1/images/edits; the model defaults to gpt-image-2.5-sunburst.
COGU_OUTFIT_PROVIDER=
COGU_OUTFIT_PROVIDER_URL=
COGU_OUTFIT_PROVIDER_MODEL=
COGU_OUTFIT_PROVIDER_API_KEY=
# Used in openai mode when COGU_OUTFIT_PROVIDER_API_KEY is empty.
OPENAI_API_KEY=
# Set COGU_OUTFIT_PROVIDER=gemini for Gemini Interactions image generation.
# Default model: gemini-nano-banana-2.1. Key stays on the server.
GEMINI_API_KEY=
# Free-tier option: Cloudflare Workers AI FLUX.1 schnell (10,000 Neurons/day on Workers Free).
# Set COGU_OUTFIT_PROVIDER=cloudflare and supply the server-side account ID and API token.
# This model uses text descriptions, not product reference photos.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
